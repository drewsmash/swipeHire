# Copy this file to .env and change the passwords. Never commit .env.
#   cp .env.example .env

# --- Database (used by the web container) ---
DB_NAME=swipehire
DB_USER=swipehire_app
DB_PASSWORD=change-me

# Administrator password for the MySQL container. The app never uses it.
MYSQL_ROOT_PASSWORD=change-me-root

# Signs login cookies. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# Password given to every seeded demo account (see AGENTS.md for the emails).
DEMO_PASSWORD=swipehire

# Where the website is published. 127.0.0.1 = this computer only.
# Set WEB_BIND=0.0.0.0 to open it to your local network.
WEB_BIND=127.0.0.1
WEB_PORT=8095
